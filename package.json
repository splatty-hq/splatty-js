{
  "name": "splatty",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript client for Splatty. Captures exceptions and logs and ships them over the envelope protocol.",
  "keywords": ["splatty", "error-tracking", "logging", "observability"],
  "license": "MIT",
  "author": "k0va1",
  "repository": {
    "type": "git",
    "url": "https://github.com/k0va1/splatty-js.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
