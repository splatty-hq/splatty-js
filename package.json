{
  "name": "splatty",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript client for Splatty. Captures exceptions and logs and ships them over the envelope protocol.",
  "keywords": [
    "splatty",
    "error-tracking",
    "logging",
    "observability"
  ],
  "license": "MIT",
  "author": "k0va1",
  "repository": {
    "type": "git",
    "url": "https://github.com/splatty-hq/splatty-js.git"
  },
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/esm/express.js",
      "require": "./dist/express.js"
    },
    "./pino": {
      "types": "./dist/pino.d.ts",
      "import": "./dist/esm/pino.js",
      "require": "./dist/pino.js"
    },
    "./winston": {
      "types": "./dist/winston.d.ts",
      "import": "./dist/esm/winston.js",
      "require": "./dist/winston.js"
    },
    "./bullmq": {
      "types": "./dist/bullmq.d.ts",
      "import": "./dist/esm/bullmq.js",
      "require": "./dist/bullmq.js"
    },
    "./console": {
      "types": "./dist/console.d.ts",
      "import": "./dist/esm/console.js",
      "require": "./dist/console.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "import": "./dist/esm/process.js",
      "require": "./dist/process.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node scripts/esm-package.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
